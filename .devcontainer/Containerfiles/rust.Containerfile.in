#include "base.Containerfile"

RUN cat <<EOF >>${BREWFILE}
  brew "rustup"
  ##// Needed for `linker = "clang"` below
  brew "llvm"
  brew "sccache"
EOF

##// Setup wild linker and sccache
RUN <<EOF
  mkdir -p ~/.cargo

cat <<EOF2 >> ~/.cargo/config.toml
[build]
rustc-wrapper = "sccache"

[target.x86_64-unknown-linux-gnu]
linker = "clang"
rustflags = ["-Clink-arg=--ld-path=wild"]
EOF2

EOF
