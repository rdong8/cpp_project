[conf]
tools.build:compiler_executables={'c': 'clang', 'cpp': 'clang++'}

# TODO: brew's LLVM is build with libstdc++, can't use libc++
# To use libc++:
# Add to cxxflags: -stdlib++-isystem ${HOMEBREW_PREFIX}/include/c++/v1
# Add to linkflags: -L${HOMEBREW_PREFIX}/lib -Wl,-rpath,${HOMEBREW_PREFIX}/lib

# Initializes [this](https://cmake.org/cmake/help/latest/variable/CMAKE_LANG_FLAGS_CONFIG.html) variable
{%
    set cxxflags = [
    ]
%}
tools.build:cxxflags += {{ cxxflags }}

# CMAKE_EXPERIMENTAL_*: https://gitlab.kitware.com/cmake/cmake/-/blob/master/Help/dev/experimental.rst?ref_type=heads
# CMAKE_LINKER_TYPE: TODO: https://github.com/conan-io/conan/issues/15864, https://github.com/conan-io/conan/issues/14174
# CMAKE_OPTIMIZE_DEPENDENCIES: TODO: causes issues:
#   - https://github.com/conan-io/conan-center-index/issues/29431#issuecomment-3804881699
#   - https://gitlab.kitware.com/cmake/cmake/-/work_items/27777
{%
    set cmake_extra_variables = {
        'CMAKE_COLOR_DIAGNOSTICS': 'ON',
        'CMAKE_CXX_COMPILER_LAUNCHER': 'sccache',
        'CMAKE_CXX_VISIBILITY_PRESET': 'hidden',
        'CMAKE_C_COMPILER_LAUNCHER': 'sccache',
        'CMAKE_EXPERIMENTAL_CXX_IMPORT_STD': 'f35a9ac6-8463-4d38-8eec-5d6008153e7d',
        'CMAKE_EXPERIMENTAL_EXPORT_BUILD_DATABASE': '70ef007e-b743-492d-9407-e35eeac03a40',
        'CMAKE_EXPERIMENTAL_EXPORT_PACKAGE_DEPENDENCIES': '1942b4fa-b2c5-4546-9385-83f254070067',
        'CMAKE_EXPERIMENTAL_GENERATE_SBOM': '2d856d6d-53e8-488b-a17f-d486d2cac317',
        'CMAKE_EXPERIMENTAL_MAPPED_PACKAGE_INFO': 'ababa1b5-7099-495f-a9cd-e22d38f274f2',
        'CMAKE_EXPERIMENTAL_RUST': 'b6fdddce-bf66-41a5-bc5f-077f6fa4d2a1',
        'CMAKE_LINKER_TYPE': 'WILD',
        'CMAKE_OPTIMIZE_DEPENDENCIES': 'OFF',
        'CMAKE_VISIBILITY_INLINES_HIDDEN': 'ON'
    }
%}
tools.cmake.cmaketoolchain:extra_variables = {{ cmake_extra_variables }}

tools.cmake.cmaketoolchain:generator = Ninja Multi-Config

[platform_tool_requires]
# Tell Conan to look for CMake on the machine instead of installing it itself
cmake/4.4.3

[settings]
arch = x86_64
compiler = clang
compiler.cppstd = 26
compiler.libcxx = libstdc++11
compiler.version = 23
os = Linux
